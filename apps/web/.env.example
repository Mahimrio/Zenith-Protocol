# URL for the Laravel API Backend
# Uses Vite dev proxy (/api → 127.0.0.1:8000) — keep as /api in dev
VITE_API_URL=/api

# The name of the application
VITE_APP_NAME=ZenithOS

# Laravel Reverb connection keys
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
