    "@types/react-dom": "^19.2.3",
    "turbo": "latest"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.2.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.14.0",
    "mitt": "^3.0.1",
    "react-router-dom": "^7.14.2",
    "three": "^0.184.0",
    "zustand": "^5.0.13"
  }
}
